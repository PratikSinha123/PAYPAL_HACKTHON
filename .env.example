PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE=https://api-m.sandbox.paypal.com
PORTAL_SECRET=change-me
OWNER_PASSWORD=change-me
DB_PATH=chargeguard.db
PORT=3000
# AI Provider (Any OpenAI-compatible provider. Defaults below are Gemini)
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-3.5-flash
AI_MOCK=false
MERCHANT_TONE=professional

# Optional and untested: PayPal only lets REST apps attach to business accounts, so the easy way to open a
# sandbox dispute is as the personal account in the browser (Resolution Center).
BUYER_CLIENT_ID=
BUYER_CLIENT_SECRET=
BUYER_EMAIL=
